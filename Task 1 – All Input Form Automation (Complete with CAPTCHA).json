    {
      "parameters": {
        "jsCode": "// Extract CAPTCHA math question from login page HTML\nconst html = $input.first().json.data || $input.first().json.body;\n\n// Find the CAPTCHA challenge text, e.g. \"51 + 5 = ?\"\nconst captchaMatch = html.match(/([\\d]+)\\s*([\\+\\-\\*\\\/])\\s*([\\d]+)\\s*=\\s*\\?/);\n\nlet captchaAnswer = '';\nlet captchaQuestion = '';\n\nif (captchaMatch) {\n    const num1 = parseInt(captchaMatch[1]);\n    const operator = captchaMatch[2];\n    const num2 = parseInt(captchaMatch[3]);\n    \n    captchaQuestion = `${num1} ${operator} ${num2}`;\n    \n    // Calculate the answer\n    switch(operator) {\n        case '+':\n            captchaAnswer = num1 + num2;\n            break;\n        case '-':\n            captchaAnswer = num1 - num2;\n            break;\n        case '*':\n            captchaAnswer = num1 * num2;\n            break;\n        case '/':\n            captchaAnswer = num1 / num2;\n            break;\n    }\n}\n\nreturn {\n    json: {\n        captchaQuestion,\n        captchaAnswer: captchaAnswer.toString()\n    }\n};"
      },
      "id": "3d4e12c2-2589-4eb7-83a7-76f5499027f5",
      "name": "Step 2: Solve CAPTCHA Math",
      "type": "n8n-nodes-base.code",
