    {
      "parameters": {
        "jsCode": "// ─── Check if form submitted successfully ───\nconst statusCode = $input.item.json.statusCode;\nconst body = $input.item.json.body || '';\n\nconst isSuccess = \n  statusCode === 200 || \n  statusCode === 302 ||\n  body.includes('successfully') ||\n  body.includes('Full form submitted') ||\n  body.includes('Data stored');\n\nreturn [{\n  json: {\n    submission_status: isSuccess ? 'SUCCESS' : 'FAILED',\n    http_status_code:  statusCode,\n    success_message:   isSuccess ? 'Form submitted and data stored in Flask database!' : 'Submission may have failed - check response body',\n    response_preview:  body.substring(0, 300),\n    timestamp:         new Date().toISOString()\n  }\n}];\n"
      },
