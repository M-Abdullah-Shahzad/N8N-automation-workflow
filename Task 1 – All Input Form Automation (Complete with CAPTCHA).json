      "name": "Step 1: Get Login Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1744,
        128
      ],
      "notes": "Fetches the login page HTML to extract the CAPTCHA math question and session cookie"
