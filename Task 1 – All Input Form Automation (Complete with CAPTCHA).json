      "notes": "POSTs login credentials + solved CAPTCHA answer. followRedirects=false so we capture the session cookie from the redirect response."
    },
    {
      "parameters": {
        "jsCode": "// ─── Extract the authenticated session cookie after login ───\nconst headers = $input.item.json.headers || {};\nconst statusCode = $input.item.json.statusCode;\n\n// After successful login Flask redirects (302) and sets a new session cookie\nconst setCookieHeader = headers['set-cookie'];\nlet authCookie = '';\n\nif (Array.isArray(setCookieHeader)) {\n  authCookie = setCookieHeader.map(c => c.split(';')[0]).join('; ');\n} else if (typeof setCookieHeader === 'string') {\n  authCookie = setCookieHeader.split(';')[0];\n}\n\n// Also try to get it from the previous step if no new cookie was set\nif (!authCookie) {\n  authCookie = $('Step 2: Solve CAPTCHA Math').item.json.session_cookie;\n}\n\nconst loginSucceeded = (statusCode === 302 || statusCode === 200);\n\nreturn [{\n  json: {\n    auth_cookie:    authCookie,\n    login_status:   loginSucceeded ? 'SUCCESS' : 'FAILED',\n    status_code:    statusCode,\n    ready_to_submit: loginSucceeded\n  }\n}];\n"
      },
